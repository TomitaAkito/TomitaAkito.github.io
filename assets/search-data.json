---
layout: null
permalink: /assets/search-data.json
---
[
  {% assign is_first = true %}
  {% comment %}1. News (お知らせ・発表) - hidden: true または published: false を除外{% endcomment %}
  {% assign visible_posts = site.posts | where_exp: "item", "item.hidden != true" | where_exp: "item", "item.published != false" %}
  {% for post in visible_posts %}
    {% unless is_first %},{% endunless %}
    {
      "type": "News",
      "title": {{ post.title | strip | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: "%Y.%m.%d" | jsonify }},
      "categories": {{ post.categories | jsonify }},
      "content": {{ post.content | strip_html | strip_newlines | truncate: 500 | jsonify }}
    }
    {% assign is_first = false %}
  {% endfor %}

  {% comment %}2. Research (研究一覧) - hidden: true または published: false を除外{% endcomment %}
  {% assign visible_research = site.research | where_exp: "item", "item.hidden != true" | where_exp: "item", "item.published != false" %}
  {% for r in visible_research %}
    {% unless is_first %},{% endunless %}
    {% capture r_content %}{{ r.summary }} {{ r.title_en }} {{ r.content | strip_html | strip_newlines | truncate: 500 }}{% endcapture %}
    {% assign r_cats = r.keywords | default: r.tags %}
    {
      "type": "Research",
      "title": {{ r.title | strip | jsonify }},
      "url": {{ r.url | relative_url | jsonify }},
      "date": {{ r.period | default: r.year | default: "Research" | jsonify }},
      "categories": {{ r_cats | jsonify }},
      "content": {{ r_content | strip | jsonify }}
    }
    {% assign is_first = false %}
  {% endfor %}

  {% comment %}3. DEMO (リアルタイム映像解析デモ 各機能・全体){% endcomment %}
  {% unless is_first %},{% endunless %}
  {
    "type": "Demo",
    "title": "リアルタイム映像解析デモ (Vision Demo Studio)",
    "url": {{ '/video-demo.html' | relative_url | jsonify }},
    "date": "DEMO",
    "categories": ["DEMO", "映像解析", "AI", "Webカメラ"],
    "content": "Webカメラを使用したリアルタイム映像解析デモ。ブラウザ完結で動作し、物体検出、表情検出、深度推定、顕著性マップ、オプティカルフロー、エッジ検出、AR・MR体験などが可能です。"
  },
  {
    "type": "Demo",
    "title": "物体検出 (Object Detection) - リアルタイム映像解析デモ",
